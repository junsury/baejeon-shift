rules_version = '2';
// 배전센터 근무표 — Firestore 보안 규칙
// 역할: main(메인관리자) · sub(서브관리자) · member(팀원) · family(가족)
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(t, u) { return /databases/$(database)/documents/teams/$(t)/users/$(u); }
    function me(t) { return get(userPath(t, request.auth.uid)).data; }
    function inTeam(t) { return signedIn() && exists(userPath(t, request.auth.uid)); }
    function role(t) { return me(t).role; }
    function isMember(t) { return inTeam(t) && role(t) in ['main', 'sub', 'member']; }
    function isAdmin(t) { return inTeam(t) && role(t) in ['main', 'sub']; }
    function isMain(t) { return inTeam(t) && role(t) == 'main'; }
    function myMid(t) { return me(t).get('memberId', null); }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    // 팀을 처음 만드는 한 번(같은 묶음 쓰기 안에서 팀 문서와 내 문서를 함께 만들 때)
    function bootstrapping(t) {
      return signedIn() && !exists(teamPath(t))
        && getAfter(teamPath(t)).data.mainUid == request.auth.uid;
    }

    match /teams/{t} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.mainUid == request.auth.uid;
      allow update: if isMain(t);

      // 팀 초대 코드
      match /private/{d} {
        allow read, write: if isAdmin(t);
        allow create: if bootstrapping(t);
      }

      // 근무표 데이터: 팀원·가족 읽기, 관리자만 쓰기
      match /members/{id}     { allow read: if inTeam(t); allow write: if isAdmin(t); }
      match /assignments/{id} { allow read: if inTeam(t); allow write: if isAdmin(t); }
      match /budgets/{id}     { allow read: if inTeam(t); allow write: if isAdmin(t); }
      match /config/{id}      { allow read: if inTeam(t); allow write: if isAdmin(t); }

      // 휴가·대근·근무변경: 팀원이 등록(구두합의·승인), 관련자나 관리자가 취소
      match /events/{id} {
        allow read: if inTeam(t);
        allow create: if isMember(t);
        allow update: if isAdmin(t);
        allow delete: if isAdmin(t) || (isMember(t) && myMid(t) != null && myMid(t) in [
          resource.data.get('memberId', ''), resource.data.get('coverId', ''),
          resource.data.get('aId', ''), resource.data.get('bId', '')]);
      }

      // 요청·알림: 보낸 사람·받는 사람·관리자
      match /requests/{id} {
        allow read: if isMember(t);
        allow create: if isAdmin(t) || (isMember(t) && request.resource.data.from == myMid(t));
        allow update: if isAdmin(t) || (isMember(t) && myMid(t) != null && myMid(t) in [resource.data.from, resource.data.to]);
        allow delete: if isAdmin(t);
      }

      // 메모: 본인 쓰기, 본인과 그 가족만 읽기
      match /memos/{mid} {
        allow read: if inTeam(t) && (myMid(t) == mid || (role(t) == 'family' && me(t).familyOf == mid));
        allow write: if isMember(t) && myMid(t) == mid;
      }

      // 근무자 ↔ 계정 연결 (한 근무자에 한 계정)
      match /claims/{mid} {
        allow read: if inTeam(t);
        allow create: if isMember(t) && request.resource.data.uid == request.auth.uid
          && getAfter(userPath(t, request.auth.uid)).data.memberId == mid;
        allow delete: if isAdmin(t) || resource.data.uid == request.auth.uid;
      }

      // 가족 초대 코드
      match /familyCodes/{code} {
        allow get: if signedIn();
        allow list: if isMember(t) && resource.data.by == request.auth.uid;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && myMid(t) != null && request.resource.data.memberId == myMid(t);
        allow delete: if isAdmin(t) || resource.data.by == request.auth.uid;
      }

      // 사용자 (역할 · 연결된 근무자)
      match /users/{u} {
        allow read: if request.auth.uid == u || isMember(t);

        allow create: if signedIn() && request.auth.uid == u && (
          // 팀원: 팀 초대 코드가 맞아야 함, 근무자는 나중에 고름
          (request.resource.data.role == 'member' && request.resource.data.memberId == null
            && request.resource.data.joinCode == get(/databases/$(database)/documents/teams/$(t)/private/invite).data.code)
          // 가족: 가족 초대 코드가 가리키는 근무자의 가족
          || (request.resource.data.role == 'family'
            && request.resource.data.familyOf == get(/databases/$(database)/documents/teams/$(t)/familyCodes/$(request.resource.data.joinCode)).data.memberId)
          // 팀을 처음 만드는 사람은 메인관리자
          || (request.resource.data.role == 'main' && bootstrapping(t))
        );

        allow update: if
          // 본인: 이름·사진 등과, 아직 비어 있는 근무자를 한 번 고르기 (역할은 못 바꿈)
          (request.auth.uid == u
            && request.resource.data.role == resource.data.role
            && request.resource.data.get('familyOf', null) == resource.data.get('familyOf', null)
            && (request.resource.data.get('memberId', null) == resource.data.get('memberId', null)
                || (resource.data.get('memberId', null) == null
                    && getAfter(/databases/$(database)/documents/teams/$(t)/claims/$(request.resource.data.memberId)).data.uid == u)))
          // 메인관리자: 역할 지정·해제·넘기기, 연결 해제
          || isMain(t)
          // 서브관리자: 팀원·가족의 근무자 연결만 해제
          || (isAdmin(t) && resource.data.role in ['member', 'family']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId'])
              && request.resource.data.memberId == null);

        allow delete: if request.auth.uid == u
          || isMain(t)
          || (isAdmin(t) && resource.data.role in ['member', 'family'])
          // 팀원은 자기 가족의 연결을 끊을 수 있음
          || (isMember(t) && resource.data.role == 'family' && resource.data.familyOf == myMid(t));
      }
    }
  }
}
