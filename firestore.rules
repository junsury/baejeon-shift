rules_version = '2';
// 배전센터 근무표 — Firestore 보안 규칙
// 역할: main(메인관리자) · sub(서브관리자) · member(팀원) · family(가족, 로그인 없는 링크)
//       pending(승인 대기) · rejected(거절됨) — 대기·거절 상태는 근무 데이터를 못 봄
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // 구글 로그인한 사람 (가족 링크의 익명 로그인은 제외)
    function realUser() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function docs() { return /databases/$(database)/documents; }
    function userPath(t, u) { return /databases/$(database)/documents/teams/$(t)/users/$(u); }
    function me(t) { return get(userPath(t, request.auth.uid)).data; }
    function hasMe(t) { return signedIn() && exists(userPath(t, request.auth.uid)); }
    function role(t) { return me(t).role; }
    // 가족은 링크가 살아 있을 때만
    function famOk(t) { return role(t) != 'family' || exists(/databases/$(database)/documents/teams/$(t)/familyLinks/$(me(t).linkToken)); }
    function inTeam(t) { return hasMe(t) && role(t) in ['main', 'sub', 'member', 'family'] && famOk(t); }
    function isMember(t) { return hasMe(t) && role(t) in ['main', 'sub', 'member']; }
    function isAdmin(t) { return hasMe(t) && role(t) in ['main', 'sub']; }
    function isMain(t) { return hasMe(t) && role(t) == 'main'; }
    function myMid(t) { return me(t).get('memberId', null); }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function claimPath(t, mid) { return /databases/$(database)/documents/teams/$(t)/claims/$(mid); }
    // 팀을 처음 만드는 한 번(같은 묶음 쓰기 안에서 팀 문서와 내 문서를 함께 만들 때)
    function bootstrapping(t) {
      return realUser() && !exists(teamPath(t))
        && getAfter(teamPath(t)).data.mainUid == request.auth.uid;
    }

    match /teams/{t} {
      allow get: if signedIn();
      allow create: if realUser() && request.resource.data.mainUid == request.auth.uid;
      allow update: if isMain(t);

      // 근무표 데이터: 팀원·가족 읽기, 관리자만 쓰기 (근무자 이름은 가입 요청 화면용으로 로그인한 사람에게 공개)
      match /members/{id}     { allow read: if inTeam(t) || realUser(); allow write: if isAdmin(t); }
      match /assignments/{id} { allow read: if inTeam(t); allow write: if isAdmin(t); }
      match /budgets/{id}     { allow read: if inTeam(t); allow write: if isAdmin(t); }
      match /config/{id}      { allow read: if inTeam(t); allow write: if isAdmin(t); }

      // 휴가·대근·근무변경: 팀원이 등록(구두합의·승인), 관련자나 관리자가 취소
      match /events/{id} {
        allow read: if inTeam(t);
        allow create: if isMember(t);
        allow update: if isAdmin(t);
        allow delete: if isAdmin(t) || (isMember(t) && myMid(t) != null && myMid(t) in [
          resource.data.get('memberId', ''), resource.data.get('coverId', ''),
          resource.data.get('aId', ''), resource.data.get('bId', '')]);
      }

      // 갤럭시 앱 공유용 임시 파일: 팀원이 올리기만, 읽기는 서버(shareFile)만
      match /shares/{id} {
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid;
        match /p/{i} { allow create: if isMember(t); }
      }

      // 요청·알림: 보낸 사람·받는 사람·관리자
      match /requests/{id} {
        allow read: if isMember(t);
        allow create: if isAdmin(t) || (isMember(t) && request.resource.data.from == myMid(t));
        allow update: if isAdmin(t) || (isMember(t) && myMid(t) != null && myMid(t) in [resource.data.from, resource.data.to]);
        allow delete: if isAdmin(t);
      }

      // 메모: 본인 쓰기, 본인과 그 가족만 읽기 (관리자도 못 봄)
      match /memos/{mid} {
        allow read: if inTeam(t) && (myMid(t) == mid || (role(t) == 'family' && me(t).familyOf == mid));
        allow write: if isMember(t) && myMid(t) == mid;
      }

      // 근무자 ↔ 계정 연결 (한 근무자에 한 계정). 관리자가 승인할 때 만듦
      match /claims/{mid} {
        allow read: if inTeam(t) || realUser();
        allow create: if isAdmin(t) && getAfter(userPath(t, request.resource.data.uid)).data.memberId == mid;
        allow delete: if isAdmin(t) || resource.data.uid == request.auth.uid;
      }

      // 변경 이력: 팀원이 남기고, 고치거나 지울 수 없음
      match /history/{id} {
        allow read: if isMember(t);
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid;
      }

      // 자동 백업: 서버가 만들고 관리자만 읽음 (개인 메모는 백업하지 않음)
      match /backups/{id} {
        allow read: if isAdmin(t);
        match /parts/{p} { allow read: if isAdmin(t); }
      }

      // 갤럭시 앱이 올린 내 휴대폰 캘린더 일정 (본인만 읽음, 쓰기는 서버만)
      match /calcache/{mid} {
        allow read: if isMember(t) && myMid(t) == mid;
      }

      // 갤럭시 위젯 연결 (서버만 읽음)
      match /widgetLinks/{token} {
        allow list: if isMember(t) && resource.data.by == request.auth.uid;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && myMid(t) != null && request.resource.data.memberId == myMid(t);
        allow delete: if isAdmin(t) || resource.data.by == request.auth.uid;
      }

      // 캘린더 구독 링크 (서버만 읽음)
      match /calLinks/{token} {
        allow list: if isMember(t) && resource.data.by == request.auth.uid;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && myMid(t) != null && request.resource.data.memberId == myMid(t);
        allow delete: if isAdmin(t) || resource.data.by == request.auth.uid;
      }

      // 가족 보기 링크 (로그인 없이 보는 토큰)
      match /familyLinks/{token} {
        allow get: if signedIn();
        allow list: if isMember(t) && resource.data.by == request.auth.uid;
        allow create: if isMember(t) && request.resource.data.by == request.auth.uid
          && myMid(t) != null && request.resource.data.memberId == myMid(t);
        allow delete: if isAdmin(t) || resource.data.by == request.auth.uid;
      }

      // 사용자 (역할 · 연결된 근무자)
      match /users/{u} {
        allow read: if request.auth.uid == u || isMember(t);

        allow create: if signedIn() && request.auth.uid == u && (
          // 팀원: 본인 이름을 골라 승인 요청 (이미 연결된 이름은 안 됨)
          (realUser() && request.resource.data.role == 'pending' && request.resource.data.memberId == null
            && request.resource.data.requestedMemberId is string
            && !exists(claimPath(t, request.resource.data.requestedMemberId)))
          // 가족: 살아 있는 가족 링크가 가리키는 근무자
          || (request.resource.data.role == 'family'
            && request.resource.data.familyOf == get(/databases/$(database)/documents/teams/$(t)/familyLinks/$(request.resource.data.linkToken)).data.memberId)
          // 팀을 처음 만드는 사람은 메인관리자
          || (request.resource.data.role == 'main' && bootstrapping(t))
        );

        allow update: if
          // 본인: 이름·사진·메일만
          (request.auth.uid == u && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photo', 'email', 'remind', 'mode']))
          // 메인관리자: 역할 지정·해제·넘기기, 승인, 본인 근무자 연결
          || isMain(t)
          // 서브관리자: 가입 승인·거절, 본인 근무자 연결
          || (isAdmin(t) && resource.data.role in ['pending', 'rejected']
              && request.resource.data.role in ['member', 'rejected']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'memberId', 'approvedAt', 'approvedBy']))
          || (isAdmin(t) && request.auth.uid == u && resource.data.get('memberId', null) == null
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId'])
              && getAfter(claimPath(t, request.resource.data.memberId)).data.uid == u);

        allow delete: if request.auth.uid == u
          || isMain(t)
          || (isAdmin(t) && resource.data.role in ['pending', 'rejected', 'member', 'family'])
          // 팀원은 자기 가족 링크로 들어온 기기를 끊을 수 있음
          || (isMember(t) && resource.data.role == 'family' && resource.data.familyOf == myMid(t));

        // 푸시 알림 받을 기기 (본인만)
        match /tokens/{tok} {
          allow read, write: if request.auth.uid == u;
        }
      }
    }
  }
}
